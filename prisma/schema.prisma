// Smart Global ERP — Production schema
// Owner: Smart WebStudio (Mohammad Sayem)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(STAFF)
  phone         String?
  avatar        String?
  department    String?
  designation   String?
  status        UserStatus @default(ACTIVE)
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  salesOrders       SalesOrder[]       @relation("salesRep")
  purchaseOrders    PurchaseOrder[]    @relation("buyer")
  stockAdjustments  StockAdjustment[]
  auditLogs         AuditLog[]
  notifications     Notification[]     @relation("recipient")
}

enum UserRole {
  SUPER_ADMIN
  CEO
  MANAGER
  STAFF
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ============================================================
// ORGANIZATION
// ============================================================

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  phone       String?
  managerId   String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  warehouses  Warehouse[]
  salesOrders SalesOrder[]
  purchaseOrders PurchaseOrder[]
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  address     String?
  capacity    Int      @default(1000)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockItems      StockItem[]
  stockAdjustments StockAdjustment[]
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  products    Product[]
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?    @relation(fields: [brandId], references: [id])
  unit        String   @default("pcs")
  costPrice   Float    @default(0)
  salePrice   Float    @default(0)
  reorderLevel Int     @default(10)
  barcode     String?
  imageUrl    String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockItems      StockItem[]
  stockAdjustments StockAdjustment[]
  salesOrderItems SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  email       String?
  phone       String?
  address     String?
  country     String   @default("Bangladesh")
  segment     CustomerSegment @default(SME)
  creditLimit Float    @default(0)
  status      CustomerStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrders SalesOrder[]
}

enum CustomerSegment {
  ENTERPRISE
  SME
  RETAIL
  VIP
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Vendor {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactPerson String?
  email       String?
  phone       String?
  address     String?
  country     String   @default("Bangladesh")
  category    String?
  creditDays  Int      @default(30)
  creditLimit Float    @default(0)
  rating      Float    @default(4.0)
  status      VendorStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

// ============================================================
// SALES
// ============================================================

model SalesOrder {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  salesRepId  String?
  salesRep    User?    @relation("salesRep", fields: [salesRepId], references: [id])
  orderDate   DateTime @default(now())
  deliveryDate DateTime?
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0)
  discountAmount Float @default(0)
  totalAmount Float    @default(0)
  paidAmount  Float    @default(0)
  paymentMethod String?
  status      SalesOrderStatus @default(PENDING)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       SalesOrderItem[]
}

enum SalesOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  RETURNED
}

model SalesOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

// ============================================================
// PURCHASE
// ============================================================

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  buyerId     String?
  buyer       User?    @relation("buyer", fields: [buyerId], references: [id])
  orderDate   DateTime @default(now())
  expectedDate DateTime?
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0)
  totalAmount Float    @default(0)
  paidAmount  Float    @default(0)
  grnStatus   GrnStatus @default(PENDING)
  status      PurchaseOrderStatus @default(PENDING)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PurchaseOrderItem[]
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum GrnStatus {
  PENDING
  PARTIAL
  COMPLETED
}

model PurchaseOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

// ============================================================
// INVENTORY
// ============================================================

model StockItem {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int      @default(0)
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockAdjustment {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  adjustedBy  String
  user        User     @relation(fields: [adjustedBy], references: [id])
  adjustmentType String // IN, OUT, TRANSFER, DAMAGE, RETURN
  quantity    Int
  reason      String?
  createdAt   DateTime @default(now())
}

// ============================================================
// SYSTEM
// ============================================================

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        String   // info, success, warning, error
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entity      String   // Customer, Vendor, Product, etc.
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}
